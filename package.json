{
  "name": "dsh-memory-tide",
  "version": "0.1.1",
  "description": "Tide memory for DeepSeek Harness: daily notes kept in a hot/cold archive with an index each, so the agent always has a small, hot index in context and can still reach months back. 潮汐记忆：每天一份记忆，按调用频率在热档与冷档之间升降，热档索引常驻、冷档索引按需翻。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "notes",
    "archive",
    "index",
    "context-engineering"
  ],
  "homepage": "https://github.com/XHszDHM/dsh-memory-tide#readme",
  "bugs": {
    "url": "https://github.com/XHszDHM/dsh-memory-tide/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XHszDHM/dsh-memory-tide.git"
  },
  "author": "XHszDHM",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./paths": "./src/paths.js",
    "./config": "./src/config.js",
    "./store": "./src/store.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
